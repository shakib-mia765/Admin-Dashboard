generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { ADMIN MANAGER VIEWER }
enum UserStatus { ACTIVE SUSPENDED }
model User { id String @id @default(cuid()) email String @unique name String passwordHash String role Role @default(VIEWER) status UserStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
